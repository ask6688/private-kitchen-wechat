/* Shared only by the two cooking-record forms. */
.page.cooking-form { padding: 24rpx 30rpx calc(192rpx + env(safe-area-inset-bottom)); }
.cooking-form .cooking-heading { margin: 4rpx 0 30rpx; font-size: 32rpx; line-height: 1.4; font-weight: 600; color: #466653; }
.cooking-form .field { margin: 28rpx 0; }
.cooking-form .label { color: #69736B; font-size: 25rpx; font-weight: 400; margin-bottom: 12rpx; }
.cooking-form .name-field { margin-top: 0; }
.cooking-form .name-control { height: 96rpx; min-height: 96rpx; border-radius: 16rpx; font-size: 32rpx; background: #FFF; }
.cooking-form .photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.cooking-form .photo-item, .cooking-form .photo-add { position: relative; display: block; width: 100%; height: 0; padding: 100% 0 0; border-radius: 12rpx; overflow: hidden; background: #E9EEE5; }
.cooking-form .photo-preview { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border-radius: 12rpx; }
.cooking-form .photo-add-content, .cooking-form .photo-state { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; font-size: 23rpx; text-align: center; color: #466653; }
.cooking-form .photo-add-icon { font-size: 42rpx; line-height: 1; }
.cooking-form .photo-state { color: #778375; pointer-events: none; background: #E9EEE5; }
.cooking-form .photo-error { pointer-events: auto; font-size: 22rpx; }
.cooking-form .photo-error text { font-size: 20rpx; }
.cooking-form .photo-remove { position: absolute; top: 0; right: 0; display: flex; align-items: flex-start; justify-content: flex-end; padding: 8rpx; width: 76rpx; height: 76rpx; min-width: 44px; min-height: 44px; }
.cooking-form .photo-remove text { display: block; width: 36rpx; height: 36rpx; line-height: 33rpx; border-radius: 50%; color: #FFF; background: rgba(41, 55, 44, .76); font-size: 28rpx; text-align: center; }
.cooking-form .photo-draft-notice { margin: 0 0 24rpx; }
.cooking-form .photo-field .hint { margin-top: 14rpx; font-size: 23rpx; }
.cooking-form .date-field { display: flex; align-items: center; gap: 24rpx; }
.cooking-form .date-field .label { margin: 0; flex-shrink: 0; }
.cooking-form .date-field picker { flex: 1; min-width: 0; }
.cooking-form .date-value { display: flex; align-items: center; gap: 20rpx; min-height: 68rpx; color: #626F62; font-size: 27rpx; }
.cooking-form .date-value text { color: #7B8B7C; }
.cooking-form .cooking-note { height: 240rpx; min-height: 240rpx; padding: 22rpx 24rpx; border-radius: 16rpx; font-size: 30rpx; line-height: 1.8; }
.cooking-form .cooking-option { margin-top: 24rpx; border-radius: 16rpx; background: #E9EEE5; box-shadow: none; gap: 16rpx; }
.cooking-form .cooking-option > view { flex: 1; min-width: 0; }
.cooking-form .cooking-option switch { flex-shrink: 0; }
.cooking-form .cooking-option .label { margin-bottom: 8rpx; font-size: 28rpx; }
.cooking-form .cooking-option .hint { font-size: 23rpx; line-height: 1.6; }
.cooking-form .fixed-bottom { padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background: #F7F4EE; border-top: 1rpx solid #E5E5DC; box-shadow: none; }
.cooking-form .fixed-bottom .btn { width: 100%; border-radius: 16rpx; }
