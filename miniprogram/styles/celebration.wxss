.confetti { position:absolute;top:3%;width:7px;height:11px;border-radius:2px;pointer-events:none;animation:confetti-fall 1s ease-out both; }
@keyframes confetti-fall { 0% {opacity:0;transform:translate(0,-18px) rotate(0);} 12% {opacity:.9;} 100% {opacity:0;transform:translate(var(--drift),44vh) rotate(320deg);} }
