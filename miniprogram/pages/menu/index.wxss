.menu-page { padding: 24rpx 30rpx 48rpx; }
.menu-page.has-selection { padding-bottom: 160rpx; }
.menu-intro { padding: 20rpx 24rpx; margin-bottom: 16rpx; border-radius: 16rpx; background: #E8EEE8; }
.intro-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.intro-head .eyebrow { min-width: 0; color: #607665; font-size: 22rpx; font-weight: 500; letter-spacing: 0; word-break: break-all; }
.intro-manage { flex-shrink: 0; color: #466653; font-size: 23rpx; }
.menu-intro .title { font-size: 40rpx; line-height: 1.3; margin-top: 4rpx; font-weight: 600; }
.meal-banner { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 20rpx; margin: 0 0 16rpx; border-radius: 12rpx; background: #EFE9DF; color: #665847; font-size: 24rpx; }
.meal-banner-text { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.meal-banner-arrow { white-space: nowrap; }
.search { height: 80rpx; min-height: 80rpx; border-radius: 12rpx; margin-bottom: 18rpx; font-size: 27rpx; }
.menu-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 14rpx; }
.menu-heading-title { font-size: 30rpx; font-weight: 600; }
.menu-heading-action { color: #466653; font-size: 24rpx; white-space: nowrap; }
.menu-layout { display: flex; align-items: flex-start; gap: 12rpx; }
.category-rail { position: sticky; top: 12rpx; flex-shrink: 0; width: 128rpx; height: 62vh; border-radius: 0; background: #EAEEE8; }
.category-item { min-height: 88rpx; display: flex; align-items: center; padding: 12rpx 10rpx; color: #466653; font-size: 25rpx; line-height: 1.3; word-break: break-all; border-left: 4rpx solid #D5DED3; }
.category-item.active { background: #466653; color: #FFF; font-weight: 600; border-left-color: #466653; }
.menu-dishes { min-width: 0; flex: 1; }
.menu-empty { padding: 44rpx 20rpx; border-radius: 12rpx; background: #FFF; color: #7B867D; font-size: 24rpx; line-height: 1.5; text-align: center; }
.menu-empty .empty-title { font-size: 28rpx; }
.dish-card { display: flex; align-items: flex-start; gap: 12rpx; padding: 14rpx; margin-bottom: 14rpx; border-radius: 16rpx; box-shadow: none; }
.dish-open { display: flex; align-items: flex-start; gap: 14rpx; min-width: 0; flex: 1; }
.dish-photo { flex-shrink: 0; width: 160rpx; height: 160rpx; border-radius: 10rpx; background: #E3E9DF; }
.dish-placeholder { display: flex; align-items: center; justify-content: center; color: #67816F; font-size: 28rpx; }
.dish-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.dish-name { font-size: 29rpx; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
.dish-meta { color: #778278; font-size: 23rpx; line-height: 1.35; word-break: break-all; }
.dish-made { color: #607665; font-size: 22rpx; line-height: 1.3; }
.dish-action { flex-shrink: 0; width: 72rpx; height: 160rpx; display: flex; align-items: flex-end; justify-content: flex-end; }
.dish-select { flex-shrink: 0; display: flex; align-items: flex-end; justify-content: flex-end; width: 88rpx; height: 88rpx; min-height: 88rpx; padding: 0; margin: 0; background: transparent; border-radius: 12rpx; line-height: 1; }
.dish-select-face { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 10rpx; background: #466653; color: #FFF; font-size: 36rpx; line-height: 1; }
.dish-select.selected .dish-select-face { background: #E6EFE5; color: #3D6B4B; }
.dish-select::after { border: 0; }
.dish-restore { padding: 9rpx 10rpx; font-size: 21rpx; }
.unavailable { font-size: 20rpx; text-align: center; word-break: break-all; }
.loading { text-align: center; padding: 22rpx; }
.manage-panel { padding: 18rpx 22rpx; margin-bottom: 18rpx; border-radius: 12rpx; background: #FFF; }
.manage-switch { transform: scale(.8); transform-origin: right center; }
.manage-link { color: #466653; font-size: 25rpx; margin-top: 12rpx; }
.selection-bottom { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: flex; align-items: center; gap: 14rpx; background: #FFF; padding: 14rpx 30rpx; border-top: 1rpx solid #E3E5DF; }
.selection-summary { color: #466653; font-size: 26rpx; font-weight: 600; white-space: nowrap; }
.selection-submit { min-width: 0; flex: 1; font-size: 25rpx; }
.selection-submit.is-disabled, button.selection-submit.is-disabled[disabled]:not([type]) { background: #C9D1C9; color: #FFF; }
.selection-mask { position: fixed; z-index: 20; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: flex-end; background: rgba(20,30,24,.45); }
.selection-sheet { width: 100%; max-height: 65vh; padding: 28rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: #FFF; }
.selection-sheet-head, .selection-sheet-item, .selection-sheet-foot { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.selection-sheet-head { font-size: 29rpx; font-weight: 700; margin-bottom: 16rpx; }
.selection-sheet-list { max-height: 46vh; }
.selection-sheet-item { padding: 20rpx 0; border-bottom: 1rpx solid #EDEFEA; font-size: 26rpx; }
.selection-sheet-name { min-width: 0; flex: 1; word-break: break-all; }
.selection-remove { color: #A35F50; white-space: nowrap; }
.selection-sheet-foot { padding-top: 20rpx; color: #466653; font-size: 25rpx; }
