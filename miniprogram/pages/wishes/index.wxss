.wish-page { padding: 24rpx 30rpx 48rpx; }
.wish-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; min-height: 88rpx; }
.wish-title { flex: 1; min-width: 0; font-size: 40rpx; line-height: 1.35; font-weight: 600; }
.wish-header .wish-add { flex: 0 0 128rpx; display: flex; align-items: center; justify-content: flex-end; width: 128rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0; background: transparent; color: #466653; font-size: 26rpx; line-height: 1; white-space: nowrap; }
.wish-add::after, .wish-more::after, .wish-choice::after, .wish-complete::after { border: 0; }
.wish-count { display: flex; justify-content: space-between; margin: 24rpx 0 12rpx; color: #69736B; font-size: 25rpx; }
.wish-list { border-top: 1rpx solid #DDDCD3; }
.wish-item { padding: 10rpx 0; border-bottom: 1rpx solid #DDDCD3; }
.wish-swipe { position: relative; overflow: hidden; }
.wish-delete { position: absolute; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 100%; margin: 0; padding: 0; border-radius: 0; background: #A24D3D; color: #FFF; font-size: 25rpx; }
.wish-row { position: relative; background: #F7F4EE; transition: transform .18s ease; }
.wish-row.open { transform: translateX(-112rpx); }
.wish-main { display: flex; align-items: stretch; gap: 12rpx; width: 100%; min-width: 0; }
.wish-photo { flex: 0 0 176rpx; width: 176rpx; height: 176rpx; border-radius: 10rpx; background: #E8EDE7; }
.placeholder { display: flex; align-items: center; justify-content: center; color: #68816D; font-size: 21rpx; }
.wish-copy { flex: 1 1 0%; min-width: 0; min-height: 176rpx; display: flex; flex-direction: column; }
.wish-name { min-width: 0; max-height: 78rpx; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; word-break: break-all; line-height: 1.3; font-size: 30rpx; font-weight: 600; }
.wish-meta { margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #8D796C; font-size: 22rpx; line-height: 1.35; }
.wish-more-slot { flex: 0 0 80rpx; align-self: flex-start; width: 80rpx; }
.wish-more-slot .wish-more { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0; background: transparent; color: #7B837A; font-size: 27rpx; line-height: 1; }
.wish-actions { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; width: 100%; min-width: 0; margin-top: auto; }
.wish-actions .wish-choice, .wish-actions .wish-complete { display: flex; flex: 0 1 auto; align-items: center; justify-content: center; box-sizing: border-box; max-width: 100%; min-width: 0; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0 14rpx; top: 0; border-radius: 8rpx; font-size: 23rpx; line-height: 1.2; white-space: nowrap; }
.wish-actions .wish-choice { width: 254rpx; left: 0; }
.wish-actions .wish-complete { width: 243rpx; left: 70rpx; position: relative; }
.wish-choice, button.wish-choice[disabled]:not([type]) { background: #E8EEE8; color: #466653; }
.wish-complete, button.wish-complete[disabled]:not([type]) { background: #466653; color: #FFF; }
button.wish-choice.is-disabled[disabled]:not([type]) { background: #ECEEEA; color: #A9ADA7; }
.archived-hint { margin-top: 8rpx; color: #7E877E; font-size: 22rpx; }
.loading { text-align: center; padding: 20rpx; }
.selection-note { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 12rpx; background: #E9EEE9; color: #466653; text-align: center; line-height: 1.5; }
