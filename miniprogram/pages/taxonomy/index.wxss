.taxonomy-page { padding: 24rpx 30rpx 48rpx; }
.taxonomy-title { font-size: 40rpx; line-height: 1.35; font-weight: 600; margin-bottom: 24rpx; }
.taxonomy-tabs { display: flex; gap: 44rpx; border-bottom: 1rpx solid #DDDCD3; }
.taxonomy-tab { min-height: 88rpx; padding: 0 8rpx; margin: 0; border-radius: 0; background: transparent; color: #69736B; font-size: 29rpx; }
.taxonomy-tab::after, .taxonomy-add::after, .taxonomy-edit::after, .taxonomy-cancel::after { border: 0; }
.taxonomy-tab.active { border-bottom: 4rpx solid #466653; color: #466653; font-weight: 600; }
.taxonomy-summary { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 112rpx; color: #69736B; font-size: 25rpx; }
.taxonomy-add { position: relative; left: 121rpx; top: 0; display: flex; align-items: center; justify-content: center; height: 88rpx; padding: 0 8rpx; margin: 0; background: transparent; color: #466653; font-size: 25rpx; line-height: 1.3; }
.taxonomy-empty { padding: 36rpx 0; color: #69736B; font-size: 26rpx; }
.taxonomy-list { border-top: 1rpx solid #DDDCD3; }
.taxonomy-swipe { position: relative; overflow: hidden; }
.taxonomy-row { position: relative; z-index: 1; display: flex; align-items: center; gap: 16rpx; min-height: 112rpx; padding: 12rpx 0; border-bottom: 1rpx solid #DDDCD3; background: #F7F4EE; transition: transform .18s ease; }
.taxonomy-row.open { transform: translateX(-112rpx); }
.taxonomy-name { min-width: 0; flex: 1; font-size: 30rpx; line-height: 1.4; word-break: break-word; }
.taxonomy-edit { flex-shrink: 0; display: flex; align-items: center; justify-content: center; height: 88rpx; padding: 0 8rpx; margin: 0; background: transparent; color: #466653; font-size: 24rpx; line-height: 1.3; }
.taxonomy-delete { position: absolute; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 112rpx; height: 100%; margin: 0; padding: 0; border-radius: 0; background: #A24D3D; color: #FFF; font-size: 25rpx; }
.taxonomy-hint { padding-top: 22rpx; color: #7E877E; font-size: 23rpx; line-height: 1.5; }
.taxonomy-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(20,30,24,.42); }
.taxonomy-sheet { width: 100%; padding: 20rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: #FFF; }
.taxonomy-sheet-title { min-height: 76rpx; display: flex; align-items: center; font-size: 33rpx; font-weight: 600; }
.taxonomy-input { width: 100%; height: 96rpx; border-bottom: 1rpx solid #DDDCD3; color: #292D29; font-size: 29rpx; }
.taxonomy-save, .taxonomy-cancel { display: flex; align-items: center; justify-content: center; width: 100%; height: 88rpx; padding: 0; line-height: 1.3; text-align: center; }
.taxonomy-save { margin-top: 32rpx; }
.taxonomy-cancel { margin: 12rpx 0 0; background: transparent; color: #69736B; font-size: 26rpx; }
