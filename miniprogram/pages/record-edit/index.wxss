@import "../../styles/cooking-record.wxss";
.record-picker { display: block; width: 100%; }
.source-field .name-control { display: flex; align-items: center; height: auto; gap: 20rpx; padding: 20rpx 24rpx; line-height: 1.45; }
.select-text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.source-field .select::after { content: '⌄'; color: #7B8B7C; font-size: 30rpx; flex-shrink: 0; }
.dish-name { font-size: 36rpx; line-height: 1.45; font-weight: 600; overflow-wrap: anywhere; }
.snapshot-group { margin: 12rpx 0 24rpx; border-top: 1rpx solid #E5E5DC; }
.snapshot-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 100rpx; font-size: 28rpx; }
.snapshot-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 22rpx; }
.snapshot-tags text { padding: 8rpx 16rpx; border-radius: 10rpx; background: #E9EEE5; color: #466653; font-size: 24rpx; }
.snapshot-text { display: block; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 28rpx; line-height: 1.8; }
.snapshot-section { margin: 24rpx 0; }
.pending-hint { margin: 0 0 12rpx; text-align: center; color: #78694D; font-size: 24rpx; }
.is-locked { pointer-events: none; }
.restore-photos { display: inline-block; color: #466653; padding: 8rpx 0; margin-left: 12rpx; }

.dish-edit-actions { display:flex;gap:18rpx; }
.dish-edit-actions .btn { margin:0;flex:1;min-width:0;font-size:26rpx; }
.dish-edit-actions .ghost { flex:0 0 30%; }
.conflict-options { display:flex;flex-wrap:wrap;gap:20rpx;padding:16rpx 0;color:#466653; }
.dish-recipe-link { display:block;font-size:23rpx;font-weight:400;color:#71806A;padding-top:12rpx; }

.cooking-note { background:#FAF9F3;border:1rpx solid #DCE3D4;border-radius:16rpx;padding:22rpx;box-sizing:border-box;min-height:210rpx; }
